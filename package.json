{
  "name": "erp-agent-builder",
  "version": "0.1.0",
  "private": true,
  "description": "ERP Agent Builder 开源概念演示：面向多租户 ERP 的 Agent 开发平台",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "demo": "node scripts/demo.mjs",
    "dev": "node scripts/demo.mjs",
    "test": "vitest run && pnpm test:java",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && node scripts/mvnw.mjs -q -B spotless:check",
    "format": "prettier --write . && node scripts/mvnw.mjs -q -B spotless:apply",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p e2e",
    "assets:validate": "node scripts/java-cli.mjs assets:validate",
    "assets:assemble": "node scripts/java-cli.mjs assets:assemble",
    "test:coverage": "vitest run --coverage",
    "spec:json-schema": "node scripts/mvnw.mjs -q -B -pl eab-spec -am test -Dtest=JsonSchemaExportTest -Dsurefire.failIfNoSpecifiedTests=false -Deab.updateSchemas=true",
    "data:backup": "node scripts/java-cli.mjs data:backup",
    "seed:reset": "node scripts/java-cli.mjs seed:reset",
    "tools:import-bo": "node scripts/java-cli.mjs tools:import-bo",
    "test:java": "node scripts/mvnw.mjs -q -B verify"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
