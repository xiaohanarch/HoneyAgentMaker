{
  "name": "erp-agent-builder",
  "version": "0.1.0",
  "private": true,
  "description": "ERP Agent Builder 开源概念演示：面向多租户 ERP 的 Agent 开发平台",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "demo": "node scripts/demo.mjs",
    "dev": "node scripts/demo.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p e2e",
    "assets:validate": "tsx apps/platform/src/cli/validate-assets.ts",
    "assets:assemble": "tsx apps/platform/src/cli/assemble-agent.ts",
    "test:coverage": "vitest run --coverage",
    "spec:json-schema": "tsx packages/spec/scripts/gen-json-schema.ts",
    "data:backup": "tsx apps/platform/src/cli/backup-data.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
