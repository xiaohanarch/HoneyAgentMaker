<?xml version="1.0" encoding="UTF-8"?>
<!--
  ERP Agent Builder 后端：Maven 多模块工程（ADR 0006）。
  平台主服务 platform 与模拟 ERP demo-erp 是两个 Spring Boot 应用，
  共享的领域模块（资产模型、组装器、策略、演示目录、追踪、运行时）在后续阶段逐个加入。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>dev.eab</groupId>
  <artifactId>eab-backend</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>ERP Agent Builder 后端</name>

  <modules>
    <module>eab-common</module>
    <module>eab-spec</module>
    <module>eab-assembler</module>
    <module>eab-directory</module>
    <module>eab-policy</module>
    <module>eab-tracing</module>
    <module>eab-runtime</module>
    <module>eab-a2a</module>
    <module>eab-eval</module>
    <module>platform</module>
    <module>demo-erp</module>
    <module>eab-cli</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-ai.version>2.0.1</spring-ai.version>
    <springdoc.version>3.1.1</springdoc.version>
    <spotless.version>3.10.4</spotless.version>
    <palantir-java-format.version>2.102.0</palantir-java-format.version>
    <jacoco.version>0.8.15</jacoco.version>
    <semver4j.version>6.0.0</semver4j.version>
    <cel.version>0.14.0</cel.version>
    <nimbus-jose-jwt.version>10.10</nimbus-jose-jwt.version>
    <tink.version>1.23.0</tink.version>
    <a2a.version>1.4.0.Final</a2a.version>
    <!-- 与 A2A SDK parent 管理的版本保持一致，但 scope 显式改回 compile（见 dependencyManagement 里的说明） -->
    <okhttp.version>4.12.0</okhttp.version>
    <!-- A2A Java SDK 1.4.0 依赖 gson 2.14，覆盖 Spring Boot 管理的版本 -->
    <gson.version>2.14.0</gson.version>
    <!-- A2A SDK 的 BOM 管理到 4.35.0，CEL 的生成代码要求运行时不低于 4.35.1，取两者中较新的 -->
    <protobuf.version>4.35.1</protobuf.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.a2aproject.sdk</groupId>
        <artifactId>a2a-java-sdk-bom</artifactId>
        <version>${a2a.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- A2A SDK 的 parent pom 在 dependencyManagement 里把 okhttp 管理成 test scope（SDK 自己只拿来测试），
           经 BOM import 传进来后会连传递依赖一起压成 test，Spring Boot fat jar 只打包 runtime classpath，
           平台启动时报 NoClassDefFoundError: okhttp3/Callback。本 pom 的直接声明优先于 import 的 BOM，
           在这里把 okhttp 管理回 compile，eab-a2a 与 platform 才能拿到运行时依赖 -->
      <dependency>
        <groupId>com.squareup.okhttp3</groupId>
        <artifactId>okhttp</artifactId>
        <version>${okhttp.version}</version>
        <scope>compile</scope>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- 代码格式：pnpm lint 调用 spotless:check，pnpm format 调用 spotless:apply -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <palantirJavaFormat>
              <version>${palantir-java-format.version}</version>
            </palantirJavaFormat>
            <removeUnusedImports/>
          </java>
        </configuration>
      </plugin>
      <!-- 覆盖率报告，目标 80%（规则见 docs/decisions/0006） -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
