<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.eab</groupId>
    <artifactId>eab-backend</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>platform</artifactId>
  <name>平台主服务</name>
  <description>资产注册与组装、路由、Agent 运行时、各类网关、治理中心 API、模拟身份服务</description>

  <dependencies>
    <dependency>
      <groupId>dev.eab</groupId>
      <artifactId>eab-spec</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.eab</groupId>
      <artifactId>eab-assembler</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.eab</groupId>
      <artifactId>eab-directory</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.eab</groupId>
      <artifactId>eab-policy</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.eab</groupId>
      <artifactId>eab-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.eab</groupId>
      <artifactId>eab-a2a</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.eab</groupId>
      <artifactId>eab-eval</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 平台对外的 MCP 端点：MCP 官方 Java SDK 的 Spring WebMVC 传输 -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>mcp-spring-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <!-- 数据库由 eab-common 的 SqliteDatabase 创建，不引入 Spring Boot 的 JDBC 与 Flyway 自动配置 -->
    <dependency>
      <groupId>dev.eab</groupId>
      <artifactId>eab-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
      <version>${nimbus-jose-jwt.version}</version>
    </dependency>
    <!-- Nimbus 的 EdDSA 签名基于 Tink，这里显式引入，PemKeys 也用它由私钥种子推出公钥 -->
    <dependency>
      <groupId>com.google.crypto.tink</groupId>
      <artifactId>tink</artifactId>
      <version>${tink.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 平台与 DemoERP 的联调测试（对应 TS 版 identity/end-to-end.test.ts） -->
    <dependency>
      <groupId>dev.eab</groupId>
      <artifactId>demo-erp</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.eab</groupId>
      <artifactId>eab-spec</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>platform</finalName>
    <plugins>
      <!-- 可执行 jar 带 exec 后缀，与 DemoERP 一致 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <classifier>exec</classifier>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
