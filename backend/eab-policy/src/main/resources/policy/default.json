{
  "version": "2026.10.2",
  "rules": [
    {
      "id": "ENTRY-001",
      "checkpoint": "entry",
      "description": "用户只能使用自己租户的统一入口",
      "effect": "deny",
      "when": "input.subject.tenantId != input.target.tenantId",
      "reason": "用户 {{subject.userId}} 不属于租户 {{target.tenantId}}"
    },
    {
      "id": "ENTRY-002",
      "checkpoint": "entry",
      "description": "没有业务角色的用户不能使用统一入口",
      "effect": "deny",
      "when": "size(input.subject.operations) == 0",
      "reason": "用户 {{subject.userId}} 没有任何业务权限，不能使用统一入口"
    },
    {
      "id": "ENTRY-003",
      "checkpoint": "entry",
      "description": "岗位助手按角色开放",
      "effect": "deny",
      "when": "input.target.assistant != '' && size(input.target.allowedRoles) > 0 && !input.subject.roles.exists(r, r in input.target.allowedRoles)",
      "reason": "岗位助手 {{target.assistant}} 没有对当前角色开放"
    },
    {
      "id": "HANDOFF-001",
      "checkpoint": "handoff",
      "description": "被调用的 Agent 必须在本租户启用",
      "effect": "deny",
      "when": "!input.target.enabledForTenant",
      "reason": "{{target.ref}} 没有在本租户启用"
    },
    {
      "id": "HANDOFF-002",
      "checkpoint": "handoff",
      "description": "远程 Agent 只接受登记过的调用方",
      "effect": "deny",
      "when": "input.target.kind == 'RemoteAgent' && input.caller.type != 'router' && !(input.caller.ref in input.target.allowedCallers)",
      "reason": "{{caller.ref}} 不在远程 Agent {{target.ref}} 允许的调用方里"
    },
    {
      "id": "HANDOFF-003",
      "checkpoint": "handoff",
      "description": "子 Agent 调用深度不超过 3 层",
      "effect": "deny",
      "when": "input.caller.depth > 3",
      "reason": "Agent 调用链深度 {{caller.depth}} 超过上限 3"
    },
    {
      "id": "HANDOFF-004",
      "checkpoint": "handoff",
      "description": "外部调用方必须带身份",
      "effect": "deny",
      "when": "input.caller.type == 'external' && input.caller.ref == ''",
      "reason": "入站调用缺少调用方身份"
    },
    {
      "id": "TOOL-001",
      "checkpoint": "tool",
      "description": "只能调用有效定义里声明过的工具",
      "effect": "deny",
      "when": "!input.tool.declared",
      "reason": "工具 {{tool.name}} 没有在 {{agent.ref}} 的有效定义里声明"
    },
    {
      "id": "TOOL-002",
      "checkpoint": "tool",
      "description": "Agent 不得以集成账号身份调用业务工具",
      "effect": "deny",
      "when": "input.mode == 'integration'",
      "reason": "集成账号没有人的身份，Agent 不能用它调用业务工具"
    },
    {
      "id": "TOOL-003",
      "checkpoint": "tool",
      "description": "付款、过账类工具最高只能到 L2",
      "effect": "deny",
      "when": "input.tool.category in ['payment', 'posting'] && input.tool.writeLevel == 'L3'",
      "reason": "付款、过账类工具 {{tool.name}} 不能自主执行"
    },
    {
      "id": "TOOL-004",
      "checkpoint": "tool",
      "description": "L3 自主写需要租户管理员显式开启",
      "effect": "deny",
      "when": "input.tool.writeLevel == 'L3' && !input.tenant.l3Enabled",
      "reason": "租户未开启 L3 自主写，工具 {{tool.name}} 不能自主执行"
    },
    {
      "id": "TOOL-005",
      "checkpoint": "tool",
      "description": "职责分离：同一用户不能既提交又审批同一张单据",
      "effect": "deny",
      "when": "input.document.action == 'approve' && input.document.submittedBy != '' && input.document.submittedBy == input.subject.userId",
      "reason": "单据 {{document.id}} 由 {{subject.userId}} 提交，同一用户不能审批（职责分离）"
    },
    {
      "id": "TOOL-006",
      "checkpoint": "tool",
      "description": "受托自主运行只能使用委托范围内的工具",
      "effect": "deny",
      "when": "input.mode == 'delegated' && !input.tool.inDelegationScope",
      "reason": "工具 {{tool.name}} 不在委托 {{delegation.id}} 的授权范围内"
    },
    {
      "id": "TOOL-007",
      "checkpoint": "tool",
      "description": "受托自主运行不做需要人确认的写操作",
      "effect": "deny",
      "when": "input.mode == 'delegated' && input.tool.writeLevel == 'L2'",
      "reason": "受托自主运行时没有在线的人可以确认，L2 工具 {{tool.name}} 改为生成建议"
    },
    {
      "id": "TOOL-010",
      "checkpoint": "tool",
      "description": "L2 写操作落库前需要用户确认；技能调用本身不确认，确认落在技能内部的写操作或确认步骤上",
      "effect": "confirm",
      "when": "input.tool.writeLevel == 'L2' && input.tool.type != 'skill'",
      "reason": "{{tool.name}} 是需确认的写操作（L2）"
    },
    {
      "id": "TOOL-011",
      "checkpoint": "tool",
      "description": "标品或扩展声明的人工确认点",
      "effect": "confirm",
      "when": "input.tool.approvalPolicy == 'require-confirmation'",
      "reason": "{{tool.name}} 声明了人工确认"
    },
    {
      "id": "TOOL-012",
      "checkpoint": "tool",
      "description": "标品或扩展声明的审批点",
      "effect": "approve",
      "when": "input.tool.approvalPolicy == 'require-approval'",
      "reason": "{{tool.name}} 需要 {{tool.approverRole}} 审批"
    }
  ]
}
