{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://eab.dev/schemas/v1/EvalSuite.json",
  "title" : "EvalSuite",
  "type" : "object",
  "properties" : {
    "apiVersion" : {
      "type" : "string",
      "const" : "eab.dev/v1"
    },
    "kind" : {
      "type" : "string",
      "const" : "EvalSuite"
    },
    "metadata" : {
      "type" : "object",
      "properties" : {
        "name" : {
          "type" : "string",
          "pattern" : "^[a-z0-9][a-z0-9-]*$"
        },
        "namespace" : {
          "type" : "string"
        },
        "version" : {
          "type" : "string"
        },
        "displayName" : {
          "type" : "string",
          "minLength" : 1
        },
        "description" : {
          "type" : "string"
        },
        "owner" : {
          "type" : "string"
        },
        "businessProcess" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          }
        },
        "labels" : {
          "type" : "object",
          "propertyNames" : {
            "type" : "string"
          },
          "additionalProperties" : {
            "type" : "string"
          }
        }
      },
      "required" : [ "name", "namespace", "version" ],
      "additionalProperties" : false
    },
    "spec" : {
      "type" : "object",
      "properties" : {
        "target" : {
          "type" : "string"
        },
        "visibility" : {
          "type" : "string",
          "enum" : [ "public", "internal" ],
          "default" : "internal"
        },
        "tier" : {
          "type" : "string",
          "enum" : [ "smoke", "full" ],
          "default" : "full"
        },
        "minPassRate" : {
          "type" : "number",
          "minimum" : 0.0,
          "maximum" : 1.0,
          "default" : 1
        },
        "cases" : {
          "type" : "array",
          "items" : {
            "type" : "object",
            "properties" : {
              "id" : {
                "type" : "string",
                "minLength" : 1
              },
              "user" : {
                "type" : "string",
                "minLength" : 1
              },
              "question" : {
                "type" : "string",
                "minLength" : 1
              },
              "verifiedTask" : {
                "type" : "string"
              },
              "assertions" : {
                "type" : "array",
                "items" : {
                  "type" : "object",
                  "properties" : {
                    "type" : {
                      "type" : "string",
                      "enum" : [ "calledTool", "notCalledTool", "contains", "notContains", "numberRange", "invariant", "judge" ]
                    },
                    "tool" : {
                      "type" : "string"
                    },
                    "text" : {
                      "type" : "string"
                    },
                    "path" : {
                      "type" : "string"
                    },
                    "min" : {
                      "type" : "number"
                    },
                    "max" : {
                      "type" : "number"
                    },
                    "expression" : {
                      "type" : "string",
                      "minLength" : 1
                    },
                    "rubric" : {
                      "type" : "string"
                    },
                    "description" : {
                      "type" : "string"
                    }
                  },
                  "required" : [ "type" ],
                  "additionalProperties" : false
                },
                "minItems" : 1
              }
            },
            "required" : [ "id", "user", "question", "assertions" ],
            "additionalProperties" : false
          },
          "minItems" : 1
        }
      },
      "required" : [ "target", "cases" ],
      "additionalProperties" : false
    }
  },
  "required" : [ "apiVersion", "kind", "metadata", "spec" ],
  "additionalProperties" : false
}
