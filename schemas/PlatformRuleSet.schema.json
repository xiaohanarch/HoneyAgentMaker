{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://eab.dev/schemas/v1/PlatformRuleSet.json",
  "title" : "PlatformRuleSet",
  "type" : "object",
  "properties" : {
    "apiVersion" : {
      "type" : "string",
      "const" : "eab.dev/v1"
    },
    "kind" : {
      "type" : "string",
      "const" : "PlatformRuleSet"
    },
    "metadata" : {
      "type" : "object",
      "properties" : {
        "name" : {
          "type" : "string",
          "pattern" : "^[a-z0-9][a-z0-9-]*$"
        },
        "namespace" : {
          "type" : "string"
        },
        "version" : {
          "type" : "string"
        },
        "displayName" : {
          "type" : "string",
          "minLength" : 1
        },
        "description" : {
          "type" : "string"
        },
        "owner" : {
          "type" : "string"
        },
        "businessProcess" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          }
        },
        "labels" : {
          "type" : "object",
          "propertyNames" : {
            "type" : "string"
          },
          "additionalProperties" : {
            "type" : "string"
          }
        }
      },
      "required" : [ "name", "namespace", "version" ],
      "additionalProperties" : false
    },
    "spec" : {
      "type" : "object",
      "properties" : {
        "rules" : {
          "type" : "array",
          "items" : {
            "type" : "object",
            "properties" : {
              "id" : {
                "type" : "string",
                "pattern" : "^[A-Z][A-Z0-9]*-R-\\d{3}$"
              },
              "name" : {
                "type" : "string",
                "minLength" : 1
              },
              "description" : {
                "type" : "string",
                "minLength" : 1
              },
              "instruction" : {
                "type" : "string",
                "minLength" : 1
              },
              "enforcement" : {
                "type" : "string",
                "enum" : [ "prompt", "guard", "both" ]
              }
            },
            "required" : [ "id", "name", "description", "instruction", "enforcement" ],
            "additionalProperties" : false
          },
          "minItems" : 1
        }
      },
      "required" : [ "rules" ],
      "additionalProperties" : false
    }
  },
  "required" : [ "apiVersion", "kind", "metadata", "spec" ],
  "additionalProperties" : false
}
