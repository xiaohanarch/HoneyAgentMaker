{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://eab.dev/schemas/v1/AgentExtension.json",
  "title" : "AgentExtension",
  "type" : "object",
  "properties" : {
    "apiVersion" : {
      "type" : "string",
      "const" : "eab.dev/v1"
    },
    "kind" : {
      "type" : "string",
      "const" : "AgentExtension"
    },
    "metadata" : {
      "type" : "object",
      "properties" : {
        "name" : {
          "type" : "string",
          "pattern" : "^[a-z0-9][a-z0-9-]*$"
        },
        "namespace" : {
          "type" : "string"
        },
        "version" : {
          "type" : "string"
        },
        "displayName" : {
          "type" : "string",
          "minLength" : 1
        },
        "description" : {
          "type" : "string"
        },
        "owner" : {
          "type" : "string"
        },
        "businessProcess" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          }
        },
        "labels" : {
          "type" : "object",
          "propertyNames" : {
            "type" : "string"
          },
          "additionalProperties" : {
            "type" : "string"
          }
        }
      },
      "required" : [ "name", "namespace", "version" ],
      "additionalProperties" : false
    },
    "spec" : {
      "type" : "object",
      "properties" : {
        "target" : {
          "type" : "string"
        },
        "instructions" : {
          "type" : "object",
          "properties" : {
            "append" : {
              "type" : "string",
              "minLength" : 1
            }
          },
          "required" : [ "append" ],
          "additionalProperties" : false
        },
        "constraints" : {
          "type" : "object",
          "properties" : {
            "append" : {
              "type" : "array",
              "items" : {
                "type" : "string",
                "minLength" : 1
              },
              "minItems" : 1
            }
          },
          "required" : [ "append" ],
          "additionalProperties" : false
        },
        "tools" : {
          "type" : "object",
          "properties" : {
            "add" : {
              "type" : "array",
              "items" : {
                "anyOf" : [ {
                  "type" : "string"
                }, {
                  "type" : "object",
                  "properties" : {
                    "skill" : {
                      "type" : "string"
                    },
                    "agent" : {
                      "type" : "string"
                    },
                    "remoteAgent" : {
                      "type" : "string"
                    },
                    "mcp" : {
                      "type" : "object",
                      "properties" : {
                        "source" : {
                          "type" : "string"
                        },
                        "tools" : {
                          "type" : "array",
                          "items" : {
                            "type" : "string",
                            "minLength" : 1
                          },
                          "minItems" : 1
                        }
                      },
                      "required" : [ "source" ],
                      "additionalProperties" : false
                    },
                    "api" : {
                      "type" : "object",
                      "properties" : {
                        "source" : {
                          "type" : "string"
                        },
                        "tools" : {
                          "type" : "array",
                          "items" : {
                            "type" : "string",
                            "minLength" : 1
                          },
                          "minItems" : 1
                        }
                      },
                      "required" : [ "source" ],
                      "additionalProperties" : false
                    },
                    "documents" : {
                      "type" : "string"
                    },
                    "builtin" : {
                      "type" : "string",
                      "minLength" : 1
                    }
                  },
                  "additionalProperties" : false
                } ]
              },
              "minItems" : 1
            }
          },
          "required" : [ "add" ],
          "additionalProperties" : false
        },
        "skills" : {
          "type" : "object",
          "properties" : {
            "add" : {
              "type" : "array",
              "items" : {
                "type" : "string"
              },
              "minItems" : 1
            }
          },
          "required" : [ "add" ],
          "additionalProperties" : false
        },
        "knowledge" : {
          "type" : "object",
          "properties" : {
            "add" : {
              "type" : "array",
              "items" : {
                "type" : "string"
              },
              "minItems" : 1
            }
          },
          "required" : [ "add" ],
          "additionalProperties" : false
        },
        "hooks" : {
          "type" : "object",
          "properties" : {
            "beforeToolCall" : {
              "anyOf" : [ {
                "type" : "object",
                "properties" : {
                  "workflow" : {
                    "type" : "string"
                  },
                  "skill" : {
                    "type" : "string"
                  },
                  "when" : {
                    "type" : "string",
                    "minLength" : 1
                  }
                },
                "additionalProperties" : false
              }, {
                "type" : "array",
                "items" : {
                  "type" : "object",
                  "properties" : {
                    "workflow" : {
                      "type" : "string"
                    },
                    "skill" : {
                      "type" : "string"
                    },
                    "when" : {
                      "type" : "string",
                      "minLength" : 1
                    }
                  },
                  "additionalProperties" : false
                }
              } ]
            },
            "afterToolCall" : {
              "anyOf" : [ {
                "type" : "object",
                "properties" : {
                  "workflow" : {
                    "type" : "string"
                  },
                  "skill" : {
                    "type" : "string"
                  },
                  "when" : {
                    "type" : "string",
                    "minLength" : 1
                  }
                },
                "additionalProperties" : false
              }, {
                "type" : "array",
                "items" : {
                  "type" : "object",
                  "properties" : {
                    "workflow" : {
                      "type" : "string"
                    },
                    "skill" : {
                      "type" : "string"
                    },
                    "when" : {
                      "type" : "string",
                      "minLength" : 1
                    }
                  },
                  "additionalProperties" : false
                }
              } ]
            },
            "onResult" : {
              "anyOf" : [ {
                "type" : "object",
                "properties" : {
                  "workflow" : {
                    "type" : "string"
                  },
                  "skill" : {
                    "type" : "string"
                  },
                  "when" : {
                    "type" : "string",
                    "minLength" : 1
                  }
                },
                "additionalProperties" : false
              }, {
                "type" : "array",
                "items" : {
                  "type" : "object",
                  "properties" : {
                    "workflow" : {
                      "type" : "string"
                    },
                    "skill" : {
                      "type" : "string"
                    },
                    "when" : {
                      "type" : "string",
                      "minLength" : 1
                    }
                  },
                  "additionalProperties" : false
                }
              } ]
            },
            "onFailure" : {
              "anyOf" : [ {
                "type" : "object",
                "properties" : {
                  "workflow" : {
                    "type" : "string"
                  },
                  "skill" : {
                    "type" : "string"
                  },
                  "when" : {
                    "type" : "string",
                    "minLength" : 1
                  }
                },
                "additionalProperties" : false
              }, {
                "type" : "array",
                "items" : {
                  "type" : "object",
                  "properties" : {
                    "workflow" : {
                      "type" : "string"
                    },
                    "skill" : {
                      "type" : "string"
                    },
                    "when" : {
                      "type" : "string",
                      "minLength" : 1
                    }
                  },
                  "additionalProperties" : false
                }
              } ]
            }
          },
          "additionalProperties" : false
        },
        "approvals" : {
          "type" : "object",
          "properties" : {
            "add" : {
              "type" : "array",
              "items" : {
                "type" : "object",
                "properties" : {
                  "tool" : {
                    "type" : "string",
                    "minLength" : 1
                  },
                  "policy" : {
                    "type" : "string",
                    "enum" : [ "auto", "require-confirmation", "require-approval" ]
                  },
                  "when" : {
                    "type" : "string",
                    "minLength" : 1
                  },
                  "approverRole" : {
                    "type" : "string"
                  },
                  "description" : {
                    "type" : "string"
                  }
                },
                "required" : [ "tool", "policy" ],
                "additionalProperties" : false
              },
              "minItems" : 1
            }
          },
          "required" : [ "add" ],
          "additionalProperties" : false
        },
        "model" : {
          "type" : "object",
          "properties" : {
            "profile" : {
              "type" : "string",
              "enum" : [ "fast", "reasoning", "judge" ]
            }
          },
          "required" : [ "profile" ],
          "additionalProperties" : false
        },
        "evals" : {
          "type" : "object",
          "properties" : {
            "suites" : {
              "type" : "array",
              "items" : {
                "type" : "string"
              },
              "default" : [ ]
            }
          },
          "additionalProperties" : false
        }
      },
      "required" : [ "target" ],
      "additionalProperties" : false
    }
  },
  "required" : [ "apiVersion", "kind", "metadata", "spec" ],
  "additionalProperties" : false
}
