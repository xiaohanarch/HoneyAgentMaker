{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://eab.dev/schemas/v1/Agent.json",
  "title" : "Agent",
  "type" : "object",
  "properties" : {
    "apiVersion" : {
      "type" : "string",
      "const" : "eab.dev/v1"
    },
    "kind" : {
      "type" : "string",
      "const" : "Agent"
    },
    "metadata" : {
      "type" : "object",
      "properties" : {
        "name" : {
          "type" : "string",
          "pattern" : "^[a-z0-9][a-z0-9-]*$"
        },
        "namespace" : {
          "type" : "string"
        },
        "version" : {
          "type" : "string"
        },
        "displayName" : {
          "type" : "string",
          "minLength" : 1
        },
        "description" : {
          "type" : "string"
        },
        "owner" : {
          "type" : "string"
        },
        "businessProcess" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          }
        },
        "labels" : {
          "type" : "object",
          "propertyNames" : {
            "type" : "string"
          },
          "additionalProperties" : {
            "type" : "string"
          }
        }
      },
      "required" : [ "name", "namespace", "version" ],
      "additionalProperties" : false
    },
    "spec" : {
      "type" : "object",
      "properties" : {
        "expertise" : {
          "type" : "string",
          "minLength" : 1
        },
        "instructions" : {
          "type" : "string",
          "minLength" : 1
        },
        "publicInstructions" : {
          "type" : "string",
          "minLength" : 1
        },
        "additionalContext" : {
          "type" : "string"
        },
        "constraints" : {
          "type" : "array",
          "items" : {
            "type" : "string",
            "minLength" : 1
          },
          "default" : [ ]
        },
        "model" : {
          "type" : "object",
          "properties" : {
            "profile" : {
              "type" : "string",
              "enum" : [ "fast", "reasoning", "judge" ]
            },
            "temperature" : {
              "type" : "number",
              "minimum" : 0.0,
              "maximum" : 2.0
            }
          },
          "required" : [ "profile" ],
          "additionalProperties" : false
        },
        "executionSteps" : {
          "type" : "object",
          "properties" : {
            "pre" : {
              "type" : "array",
              "items" : {
                "type" : "object",
                "properties" : {
                  "skill" : {
                    "type" : "string"
                  },
                  "guard" : {
                    "type" : "string",
                    "minLength" : 1
                  }
                },
                "additionalProperties" : false
              },
              "default" : [ ]
            },
            "post" : {
              "type" : "array",
              "items" : {
                "type" : "object",
                "properties" : {
                  "skill" : {
                    "type" : "string"
                  },
                  "guard" : {
                    "type" : "string",
                    "minLength" : 1
                  }
                },
                "additionalProperties" : false
              },
              "default" : [ ]
            }
          },
          "additionalProperties" : false
        },
        "tools" : {
          "type" : "array",
          "items" : {
            "type" : "object",
            "properties" : {
              "skill" : {
                "type" : "string"
              },
              "agent" : {
                "type" : "string"
              },
              "remoteAgent" : {
                "type" : "string"
              },
              "mcp" : {
                "type" : "object",
                "properties" : {
                  "source" : {
                    "type" : "string"
                  },
                  "tools" : {
                    "type" : "array",
                    "items" : {
                      "type" : "string",
                      "minLength" : 1
                    },
                    "minItems" : 1
                  }
                },
                "required" : [ "source" ],
                "additionalProperties" : false
              },
              "api" : {
                "type" : "object",
                "properties" : {
                  "source" : {
                    "type" : "string"
                  },
                  "tools" : {
                    "type" : "array",
                    "items" : {
                      "type" : "string",
                      "minLength" : 1
                    },
                    "minItems" : 1
                  }
                },
                "required" : [ "source" ],
                "additionalProperties" : false
              },
              "documents" : {
                "type" : "string"
              },
              "builtin" : {
                "type" : "string",
                "minLength" : 1
              }
            },
            "additionalProperties" : false
          },
          "default" : [ ]
        },
        "semanticPacks" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          },
          "default" : [ ]
        },
        "triggers" : {
          "type" : "array",
          "items" : {
            "type" : "object",
            "properties" : {
              "type" : {
                "type" : "string",
                "enum" : [ "assistant", "event", "schedule", "agent" ]
              },
              "event" : {
                "type" : "string"
              },
              "cron" : {
                "type" : "string"
              }
            },
            "required" : [ "type" ],
            "additionalProperties" : false
          },
          "default" : [ {
            "type" : "assistant"
          } ]
        },
        "channels" : {
          "type" : "array",
          "items" : {
            "type" : "string",
            "enum" : [ "assistant-web", "im", "api" ]
          },
          "default" : [ "assistant-web" ]
        },
        "memory" : {
          "type" : "object",
          "properties" : {
            "longTerm" : {
              "type" : "boolean",
              "default" : false
            }
          },
          "additionalProperties" : false
        },
        "writePolicy" : {
          "type" : "object",
          "properties" : {
            "maxLevel" : {
              "type" : "string",
              "enum" : [ "L0", "L1", "L2", "L3" ]
            }
          },
          "required" : [ "maxLevel" ],
          "additionalProperties" : false
        },
        "approvals" : {
          "type" : "array",
          "items" : {
            "type" : "object",
            "properties" : {
              "tool" : {
                "type" : "string",
                "minLength" : 1
              },
              "policy" : {
                "type" : "string",
                "enum" : [ "auto", "require-confirmation", "require-approval" ]
              },
              "when" : {
                "type" : "string",
                "minLength" : 1
              },
              "approverRole" : {
                "type" : "string"
              },
              "description" : {
                "type" : "string"
              }
            },
            "required" : [ "tool", "policy" ],
            "additionalProperties" : false
          },
          "default" : [ ]
        },
        "hooks" : {
          "type" : "object",
          "properties" : {
            "beforeToolCall" : {
              "anyOf" : [ {
                "type" : "object",
                "properties" : {
                  "workflow" : {
                    "type" : "string"
                  },
                  "skill" : {
                    "type" : "string"
                  },
                  "when" : {
                    "type" : "string",
                    "minLength" : 1
                  }
                },
                "additionalProperties" : false
              }, {
                "type" : "array",
                "items" : {
                  "type" : "object",
                  "properties" : {
                    "workflow" : {
                      "type" : "string"
                    },
                    "skill" : {
                      "type" : "string"
                    },
                    "when" : {
                      "type" : "string",
                      "minLength" : 1
                    }
                  },
                  "additionalProperties" : false
                }
              } ]
            },
            "afterToolCall" : {
              "anyOf" : [ {
                "type" : "object",
                "properties" : {
                  "workflow" : {
                    "type" : "string"
                  },
                  "skill" : {
                    "type" : "string"
                  },
                  "when" : {
                    "type" : "string",
                    "minLength" : 1
                  }
                },
                "additionalProperties" : false
              }, {
                "type" : "array",
                "items" : {
                  "type" : "object",
                  "properties" : {
                    "workflow" : {
                      "type" : "string"
                    },
                    "skill" : {
                      "type" : "string"
                    },
                    "when" : {
                      "type" : "string",
                      "minLength" : 1
                    }
                  },
                  "additionalProperties" : false
                }
              } ]
            },
            "onResult" : {
              "anyOf" : [ {
                "type" : "object",
                "properties" : {
                  "workflow" : {
                    "type" : "string"
                  },
                  "skill" : {
                    "type" : "string"
                  },
                  "when" : {
                    "type" : "string",
                    "minLength" : 1
                  }
                },
                "additionalProperties" : false
              }, {
                "type" : "array",
                "items" : {
                  "type" : "object",
                  "properties" : {
                    "workflow" : {
                      "type" : "string"
                    },
                    "skill" : {
                      "type" : "string"
                    },
                    "when" : {
                      "type" : "string",
                      "minLength" : 1
                    }
                  },
                  "additionalProperties" : false
                }
              } ]
            },
            "onFailure" : {
              "anyOf" : [ {
                "type" : "object",
                "properties" : {
                  "workflow" : {
                    "type" : "string"
                  },
                  "skill" : {
                    "type" : "string"
                  },
                  "when" : {
                    "type" : "string",
                    "minLength" : 1
                  }
                },
                "additionalProperties" : false
              }, {
                "type" : "array",
                "items" : {
                  "type" : "object",
                  "properties" : {
                    "workflow" : {
                      "type" : "string"
                    },
                    "skill" : {
                      "type" : "string"
                    },
                    "when" : {
                      "type" : "string",
                      "minLength" : 1
                    }
                  },
                  "additionalProperties" : false
                }
              } ]
            }
          },
          "additionalProperties" : false
        },
        "output" : {
          "type" : "object",
          "properties" : {
            "schema" : {
              "type" : "object",
              "propertyNames" : {
                "type" : "string",
                "pattern" : "^[a-zA-Z_][a-zA-Z0-9_]*$"
              },
              "additionalProperties" : {
                "type" : "object",
                "properties" : {
                  "type" : {
                    "type" : "string",
                    "enum" : [ "string", "int", "double", "bool", "list", "map" ]
                  },
                  "description" : {
                    "type" : "string"
                  },
                  "enum" : {
                    "type" : "array",
                    "items" : {
                      "type" : "string"
                    }
                  }
                },
                "required" : [ "type" ],
                "additionalProperties" : false
              }
            }
          },
          "required" : [ "schema" ],
          "additionalProperties" : false
        },
        "routing" : {
          "type" : "object",
          "properties" : {
            "description" : {
              "type" : "string",
              "minLength" : 1
            },
            "examples" : {
              "type" : "array",
              "items" : {
                "type" : "string",
                "minLength" : 1
              },
              "default" : [ ]
            },
            "direct" : {
              "type" : "boolean",
              "default" : false
            }
          },
          "required" : [ "description" ],
          "additionalProperties" : false
        },
        "extensionPoints" : {
          "type" : "array",
          "items" : {
            "type" : "object",
            "properties" : {
              "type" : {
                "type" : "string",
                "enum" : [ "instructions.append", "tools.add", "skills.add", "knowledge.add", "hooks", "approvals.add", "model.select" ]
              },
              "description" : {
                "type" : "string",
                "minLength" : 1
              },
              "allowedProfiles" : {
                "type" : "array",
                "items" : {
                  "type" : "string",
                  "enum" : [ "fast", "reasoning", "judge" ]
                },
                "minItems" : 1
              },
              "events" : {
                "type" : "array",
                "items" : {
                  "type" : "string",
                  "enum" : [ "beforeToolCall", "afterToolCall", "onResult", "onFailure" ]
                },
                "minItems" : 1
              }
            },
            "required" : [ "type", "description" ],
            "additionalProperties" : false
          },
          "default" : [ ]
        },
        "evals" : {
          "type" : "object",
          "properties" : {
            "suites" : {
              "type" : "array",
              "items" : {
                "type" : "string"
              },
              "default" : [ ]
            }
          },
          "additionalProperties" : false
        }
      },
      "required" : [ "expertise", "instructions", "model", "writePolicy", "routing" ],
      "additionalProperties" : false
    }
  },
  "required" : [ "apiVersion", "kind", "metadata", "spec" ],
  "additionalProperties" : false
}
