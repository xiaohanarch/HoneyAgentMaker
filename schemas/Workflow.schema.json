{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://eab.dev/schemas/v1/Workflow.json",
  "title" : "Workflow",
  "type" : "object",
  "properties" : {
    "apiVersion" : {
      "type" : "string",
      "const" : "eab.dev/v1"
    },
    "kind" : {
      "type" : "string",
      "const" : "Workflow"
    },
    "metadata" : {
      "type" : "object",
      "properties" : {
        "name" : {
          "type" : "string",
          "pattern" : "^[a-z0-9][a-z0-9-]*$"
        },
        "namespace" : {
          "type" : "string"
        },
        "version" : {
          "type" : "string"
        },
        "displayName" : {
          "type" : "string",
          "minLength" : 1
        },
        "description" : {
          "type" : "string"
        },
        "owner" : {
          "type" : "string"
        },
        "businessProcess" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          }
        },
        "labels" : {
          "type" : "object",
          "propertyNames" : {
            "type" : "string"
          },
          "additionalProperties" : {
            "type" : "string"
          }
        }
      },
      "required" : [ "name", "namespace", "version" ],
      "additionalProperties" : false
    },
    "spec" : {
      "type" : "object",
      "properties" : {
        "inputSchema" : {
          "type" : "object",
          "propertyNames" : {
            "type" : "string"
          },
          "additionalProperties" : { }
        },
        "steps" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Step"
          },
          "minItems" : 1
        }
      },
      "required" : [ "steps" ],
      "additionalProperties" : false
    }
  },
  "required" : [ "apiVersion", "kind", "metadata", "spec" ],
  "additionalProperties" : false,
  "$defs" : {
    "Step" : {
      "type" : "object",
      "properties" : {
        "id" : {
          "type" : "string",
          "pattern" : "^[a-z0-9][a-z0-9-]*$"
        },
        "type" : {
          "type" : "string",
          "enum" : [ "tool", "skill", "agent", "transform", "condition", "parallel", "confirm", "notify", "waitEvent" ]
        },
        "name" : {
          "type" : "string"
        },
        "tool" : {
          "type" : "string",
          "minLength" : 1
        },
        "source" : {
          "type" : "string"
        },
        "skill" : {
          "type" : "string"
        },
        "agent" : {
          "type" : "string"
        },
        "with" : {
          "type" : "object",
          "propertyNames" : {
            "type" : "string"
          },
          "additionalProperties" : { }
        },
        "expression" : {
          "type" : "string",
          "minLength" : 1
        },
        "if" : {
          "type" : "string",
          "minLength" : 1
        },
        "then" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Step"
          },
          "minItems" : 1
        },
        "else" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Step"
          }
        },
        "branches" : {
          "type" : "array",
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/$defs/Step"
            },
            "minItems" : 1
          },
          "minItems" : 2
        },
        "message" : {
          "type" : "string"
        },
        "channel" : {
          "type" : "string"
        },
        "event" : {
          "type" : "string"
        },
        "timeoutSeconds" : {
          "type" : "integer",
          "minimum" : 1.0
        },
        "output" : {
          "type" : "string"
        }
      },
      "required" : [ "id", "type" ],
      "additionalProperties" : false
    }
  }
}
