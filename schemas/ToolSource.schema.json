{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://eab.dev/schemas/v1/ToolSource.json",
  "title" : "ToolSource",
  "type" : "object",
  "properties" : {
    "apiVersion" : {
      "type" : "string",
      "const" : "eab.dev/v1"
    },
    "kind" : {
      "type" : "string",
      "const" : "ToolSource"
    },
    "metadata" : {
      "type" : "object",
      "properties" : {
        "name" : {
          "type" : "string",
          "pattern" : "^[a-z0-9][a-z0-9-]*$"
        },
        "namespace" : {
          "type" : "string"
        },
        "version" : {
          "type" : "string"
        },
        "displayName" : {
          "type" : "string",
          "minLength" : 1
        },
        "description" : {
          "type" : "string"
        },
        "owner" : {
          "type" : "string"
        },
        "businessProcess" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          }
        },
        "labels" : {
          "type" : "object",
          "propertyNames" : {
            "type" : "string"
          },
          "additionalProperties" : {
            "type" : "string"
          }
        }
      },
      "required" : [ "name", "namespace", "version" ],
      "additionalProperties" : false
    },
    "spec" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "type" : "string",
          "enum" : [ "bo-api", "mcp", "http" ]
        },
        "connection" : {
          "type" : "string",
          "pattern" : "^[A-Z][A-Z0-9_]*$"
        },
        "openapiPath" : {
          "type" : "string",
          "pattern" : "^/"
        },
        "tools" : {
          "type" : "array",
          "items" : {
            "type" : "object",
            "properties" : {
              "name" : {
                "type" : "string",
                "pattern" : "^[a-z][a-z0-9_.]*$"
              },
              "description" : {
                "type" : "string",
                "minLength" : 1
              },
              "writeLevel" : {
                "type" : "string",
                "enum" : [ "L0", "L1", "L2", "L3" ]
              },
              "category" : {
                "type" : "string",
                "enum" : [ "query", "draft", "write", "payment", "posting", "notify" ]
              },
              "operation" : {
                "type" : "object",
                "properties" : {
                  "method" : {
                    "type" : "string",
                    "enum" : [ "GET", "POST", "PUT", "PATCH", "DELETE" ]
                  },
                  "path" : {
                    "type" : "string",
                    "pattern" : "^/"
                  }
                },
                "required" : [ "method", "path" ],
                "additionalProperties" : false
              },
              "inputSchema" : {
                "type" : "object",
                "propertyNames" : {
                  "type" : "string"
                },
                "additionalProperties" : { }
              },
              "outputSchema" : {
                "type" : "object",
                "propertyNames" : {
                  "type" : "string"
                },
                "additionalProperties" : { }
              }
            },
            "required" : [ "name", "description" ],
            "additionalProperties" : false
          },
          "default" : [ ]
        }
      },
      "required" : [ "type", "connection" ],
      "additionalProperties" : false
    }
  },
  "required" : [ "apiVersion", "kind", "metadata", "spec" ],
  "additionalProperties" : false
}
