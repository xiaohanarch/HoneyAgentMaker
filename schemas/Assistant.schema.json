{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://eab.dev/schemas/v1/Assistant.json",
  "title" : "Assistant",
  "type" : "object",
  "properties" : {
    "apiVersion" : {
      "type" : "string",
      "const" : "eab.dev/v1"
    },
    "kind" : {
      "type" : "string",
      "const" : "Assistant"
    },
    "metadata" : {
      "type" : "object",
      "properties" : {
        "name" : {
          "type" : "string",
          "pattern" : "^[a-z0-9][a-z0-9-]*$"
        },
        "namespace" : {
          "type" : "string"
        },
        "version" : {
          "type" : "string"
        },
        "displayName" : {
          "type" : "string",
          "minLength" : 1
        },
        "description" : {
          "type" : "string"
        },
        "owner" : {
          "type" : "string"
        },
        "businessProcess" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          }
        },
        "labels" : {
          "type" : "object",
          "propertyNames" : {
            "type" : "string"
          },
          "additionalProperties" : {
            "type" : "string"
          }
        }
      },
      "required" : [ "name", "namespace", "version" ],
      "additionalProperties" : false
    },
    "spec" : {
      "type" : "object",
      "properties" : {
        "members" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          },
          "minItems" : 1
        },
        "routing" : {
          "type" : "object",
          "properties" : {
            "description" : {
              "type" : "string",
              "minLength" : 1
            },
            "examples" : {
              "type" : "array",
              "items" : {
                "type" : "string",
                "minLength" : 1
              },
              "default" : [ ]
            },
            "direct" : {
              "type" : "boolean",
              "default" : false
            }
          },
          "required" : [ "description" ],
          "additionalProperties" : false
        },
        "kpis" : {
          "type" : "array",
          "items" : {
            "type" : "object",
            "properties" : {
              "name" : {
                "type" : "string",
                "pattern" : "^[a-z][a-z0-9_]*$"
              },
              "displayName" : {
                "type" : "string",
                "minLength" : 1
              },
              "unit" : {
                "type" : "string"
              },
              "target" : {
                "type" : "number"
              },
              "direction" : {
                "type" : "string",
                "enum" : [ "up", "down" ],
                "default" : "up"
              }
            },
            "required" : [ "name", "displayName" ],
            "additionalProperties" : false
          },
          "maxItems" : 4,
          "default" : [ ]
        },
        "triggers" : {
          "type" : "array",
          "items" : {
            "type" : "object",
            "properties" : {
              "type" : {
                "type" : "string",
                "enum" : [ "assistant", "event", "schedule", "agent" ]
              },
              "event" : {
                "type" : "string"
              },
              "cron" : {
                "type" : "string"
              }
            },
            "required" : [ "type" ],
            "additionalProperties" : false
          },
          "default" : [ {
            "type" : "assistant"
          } ]
        }
      },
      "required" : [ "members", "routing" ],
      "additionalProperties" : false
    }
  },
  "required" : [ "apiVersion", "kind", "metadata", "spec" ],
  "additionalProperties" : false
}
