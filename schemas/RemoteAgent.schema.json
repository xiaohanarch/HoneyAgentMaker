{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://eab.dev/schemas/v1/RemoteAgent.json",
  "title" : "RemoteAgent",
  "type" : "object",
  "properties" : {
    "apiVersion" : {
      "type" : "string",
      "const" : "eab.dev/v1"
    },
    "kind" : {
      "type" : "string",
      "const" : "RemoteAgent"
    },
    "metadata" : {
      "type" : "object",
      "properties" : {
        "name" : {
          "type" : "string",
          "pattern" : "^[a-z0-9][a-z0-9-]*$"
        },
        "namespace" : {
          "type" : "string"
        },
        "version" : {
          "type" : "string"
        },
        "displayName" : {
          "type" : "string",
          "minLength" : 1
        },
        "description" : {
          "type" : "string"
        },
        "owner" : {
          "type" : "string"
        },
        "businessProcess" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          }
        },
        "labels" : {
          "type" : "object",
          "propertyNames" : {
            "type" : "string"
          },
          "additionalProperties" : {
            "type" : "string"
          }
        }
      },
      "required" : [ "name", "namespace", "version" ],
      "additionalProperties" : false
    },
    "spec" : {
      "type" : "object",
      "properties" : {
        "connection" : {
          "type" : "string",
          "pattern" : "^[A-Z][A-Z0-9_]*$"
        },
        "agentCardPath" : {
          "type" : "string",
          "pattern" : "^/",
          "default" : "/.well-known/agent-card.json"
        },
        "auth" : {
          "type" : "object",
          "properties" : {
            "type" : {
              "type" : "string",
              "enum" : [ "platform-service-token", "none" ]
            }
          },
          "required" : [ "type" ],
          "additionalProperties" : false
        },
        "routing" : {
          "type" : "object",
          "properties" : {
            "description" : {
              "type" : "string",
              "minLength" : 1
            },
            "examples" : {
              "type" : "array",
              "items" : {
                "type" : "string",
                "minLength" : 1
              },
              "default" : [ ]
            },
            "direct" : {
              "type" : "boolean",
              "default" : false
            }
          },
          "required" : [ "description" ],
          "additionalProperties" : false
        },
        "allowedCallers" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          },
          "default" : [ ]
        },
        "assistant" : {
          "type" : "string"
        }
      },
      "required" : [ "connection", "auth", "routing" ],
      "additionalProperties" : false
    }
  },
  "required" : [ "apiVersion", "kind", "metadata", "spec" ],
  "additionalProperties" : false
}
