{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://eab.dev/schemas/v1/DevRequest.json",
  "title" : "DevRequest",
  "type" : "object",
  "properties" : {
    "apiVersion" : {
      "type" : "string",
      "const" : "eab.dev/v1"
    },
    "kind" : {
      "type" : "string",
      "const" : "DevRequest"
    },
    "metadata" : {
      "type" : "object",
      "properties" : {
        "name" : {
          "type" : "string",
          "pattern" : "^[a-z0-9][a-z0-9-]*$"
        },
        "namespace" : {
          "type" : "string"
        },
        "version" : {
          "type" : "string"
        },
        "displayName" : {
          "type" : "string",
          "minLength" : 1
        },
        "description" : {
          "type" : "string"
        },
        "owner" : {
          "type" : "string"
        },
        "businessProcess" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          }
        },
        "labels" : {
          "type" : "object",
          "propertyNames" : {
            "type" : "string"
          },
          "additionalProperties" : {
            "type" : "string"
          }
        }
      },
      "required" : [ "name", "namespace", "version" ],
      "additionalProperties" : false
    },
    "spec" : {
      "type" : "object",
      "properties" : {
        "requester" : {
          "type" : "string",
          "minLength" : 1
        },
        "originalText" : {
          "type" : "string",
          "minLength" : 1
        },
        "supplements" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          },
          "default" : [ ]
        },
        "context" : {
          "type" : "object",
          "properties" : {
            "assistant" : {
              "type" : "string"
            },
            "semanticObjects" : {
              "type" : "array",
              "items" : {
                "type" : "string"
              },
              "default" : [ ]
            },
            "rules" : {
              "type" : "array",
              "items" : {
                "type" : "string"
              },
              "default" : [ ]
            }
          },
          "additionalProperties" : false,
          "default" : {
            "semanticObjects" : [ ],
            "rules" : [ ]
          }
        },
        "status" : {
          "type" : "string",
          "enum" : [ "submitted", "in-progress", "delivered", "rejected" ],
          "default" : "submitted"
        }
      },
      "required" : [ "requester", "originalText" ],
      "additionalProperties" : false
    }
  },
  "required" : [ "apiVersion", "kind", "metadata", "spec" ],
  "additionalProperties" : false
}
