{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://eab.dev/schemas/v1/Connection.json",
  "title" : "Connection",
  "type" : "object",
  "properties" : {
    "apiVersion" : {
      "type" : "string",
      "const" : "eab.dev/v1"
    },
    "kind" : {
      "type" : "string",
      "const" : "Connection"
    },
    "metadata" : {
      "type" : "object",
      "properties" : {
        "name" : {
          "type" : "string",
          "pattern" : "^[a-z0-9][a-z0-9-]*$"
        },
        "namespace" : {
          "type" : "string"
        },
        "version" : {
          "type" : "string"
        },
        "displayName" : {
          "type" : "string",
          "minLength" : 1
        },
        "description" : {
          "type" : "string"
        },
        "owner" : {
          "type" : "string"
        },
        "businessProcess" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          }
        },
        "labels" : {
          "type" : "object",
          "propertyNames" : {
            "type" : "string"
          },
          "additionalProperties" : {
            "type" : "string"
          }
        }
      },
      "required" : [ "name", "namespace", "version" ],
      "additionalProperties" : false
    },
    "spec" : {
      "type" : "object",
      "properties" : {
        "alias" : {
          "type" : "string",
          "pattern" : "^[A-Z][A-Z0-9_]*$"
        },
        "type" : {
          "type" : "string",
          "enum" : [ "bo-api", "mcp", "a2a", "http" ]
        },
        "bindings" : {
          "type" : "object",
          "properties" : {
            "private" : {
              "type" : "object",
              "properties" : {
                "url" : {
                  "type" : "string",
                  "format" : "uri"
                },
                "auth" : {
                  "type" : "object",
                  "properties" : {
                    "type" : {
                      "type" : "string",
                      "enum" : [ "none", "client-credentials", "token-exchange", "platform-service-token" ]
                    },
                    "credentialRef" : {
                      "type" : "string",
                      "pattern" : "^(env|vault):[A-Za-z0-9_./-]+$"
                    }
                  },
                  "required" : [ "type" ],
                  "additionalProperties" : false
                }
              },
              "required" : [ "url", "auth" ],
              "additionalProperties" : false
            },
            "dev" : {
              "type" : "object",
              "properties" : {
                "url" : {
                  "type" : "string",
                  "format" : "uri"
                },
                "auth" : {
                  "type" : "object",
                  "properties" : {
                    "type" : {
                      "type" : "string",
                      "enum" : [ "none", "client-credentials", "token-exchange", "platform-service-token" ]
                    },
                    "credentialRef" : {
                      "type" : "string",
                      "pattern" : "^(env|vault):[A-Za-z0-9_./-]+$"
                    }
                  },
                  "required" : [ "type" ],
                  "additionalProperties" : false
                }
              },
              "required" : [ "url", "auth" ],
              "additionalProperties" : false
            },
            "test" : {
              "type" : "object",
              "properties" : {
                "url" : {
                  "type" : "string",
                  "format" : "uri"
                },
                "auth" : {
                  "type" : "object",
                  "properties" : {
                    "type" : {
                      "type" : "string",
                      "enum" : [ "none", "client-credentials", "token-exchange", "platform-service-token" ]
                    },
                    "credentialRef" : {
                      "type" : "string",
                      "pattern" : "^(env|vault):[A-Za-z0-9_./-]+$"
                    }
                  },
                  "required" : [ "type" ],
                  "additionalProperties" : false
                }
              },
              "required" : [ "url", "auth" ],
              "additionalProperties" : false
            },
            "prod" : {
              "type" : "object",
              "properties" : {
                "url" : {
                  "type" : "string",
                  "format" : "uri"
                },
                "auth" : {
                  "type" : "object",
                  "properties" : {
                    "type" : {
                      "type" : "string",
                      "enum" : [ "none", "client-credentials", "token-exchange", "platform-service-token" ]
                    },
                    "credentialRef" : {
                      "type" : "string",
                      "pattern" : "^(env|vault):[A-Za-z0-9_./-]+$"
                    }
                  },
                  "required" : [ "type" ],
                  "additionalProperties" : false
                }
              },
              "required" : [ "url", "auth" ],
              "additionalProperties" : false
            }
          },
          "additionalProperties" : false
        }
      },
      "required" : [ "alias", "type", "bindings" ],
      "additionalProperties" : false
    }
  },
  "required" : [ "apiVersion", "kind", "metadata", "spec" ],
  "additionalProperties" : false
}
