{
  "$id": "https://eab.dev/schemas/v1/SemanticPack.json",
  "title": "SemanticPack",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "eab.dev/v1"
    },
    "kind": {
      "type": "string",
      "const": "SemanticPack"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "namespace": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "businessProcess": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "namespace",
        "version"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "extends": {
          "type": "string"
        },
        "objects": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^erp\\.[a-z]+\\.[A-Za-z][A-Za-z0-9]*(@v\\d+)?$"
              },
              "description": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string"
                    },
                    "enumMeaning": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "ref"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "ref"
            ],
            "additionalProperties": false
          }
        },
        "relationships": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "verb": {
                "type": "string",
                "minLength": 1
              },
              "cardinality": {
                "type": "string",
                "enum": [
                  "one-to-one",
                  "one-to-many",
                  "many-to-one",
                  "many-to-many"
                ]
              },
              "notes": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "to",
              "verb",
              "cardinality"
            ],
            "additionalProperties": false
          }
        },
        "metrics": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "displayName": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "displayName",
              "definition"
            ],
            "additionalProperties": false
          }
        },
        "rules": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*-R-\\d{3}$"
              },
              "ref": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "block",
                  "warn",
                  "info"
                ]
              },
              "description": {
                "type": "string"
              },
              "remedy": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "severity",
              "remedy"
            ],
            "additionalProperties": false
          }
        },
        "agent_instructions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verified_tasks": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*-VT-\\d{3}$"
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "expected_conclusion": {
                "type": "string",
                "minLength": 1
              },
              "fail_if": {
                "type": "string"
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "question",
              "expected_conclusion"
            ],
            "additionalProperties": false
          }
        },
        "permissions": {
          "type": "object",
          "properties": {
            "filter_dimensions": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "inherit_from": {
              "type": "string"
            },
            "disclose_filtered": {
              "default": true,
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
